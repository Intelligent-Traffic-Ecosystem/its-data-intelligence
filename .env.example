# Kafka
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC_INPUT=traffic.events.raw

# PostgreSQL
POSTGRES_URL=postgresql://user:pass@postgres:5432/traffic

# Stream Processor
WINDOW_SIZE_SECONDS=5
WINDOW_ALLOWED_LATENESS_SECONDS=1
FLINK_PARALLELISM=1
FLINK_CHECKPOINT_INTERVAL_MS=30000

# Congestion Thresholds
CONGESTION_WEIGHT_COUNT=0.4
CONGESTION_WEIGHT_SPEED=0.4
CONGESTION_WEIGHT_STOPPED=0.2
CONGESTION_THRESHOLD_LOW=0.30
CONGESTION_THRESHOLD_MODERATE=0.55
CONGESTION_THRESHOLD_HIGH=0.80

# Normalisation maximums
MAX_VEHICLE_COUNT=50
MAX_SPEED_KMH=60

# API
API_HOST=0.0.0.0
API_PORT=8000
WS_BROADCAST_INTERVAL=5

# Speed fallback (when B1 omits speed_estimate)
SPEED_TRACKER_TTL_SECONDS=30
SPEED_TRACKER_PIXEL_TO_METER=0.05
CAMERA_CALIBRATIONS={"cam_01":0.05,"cam_02":0.06}

# Raw event batched writer
RAW_WRITER_BATCH_SIZE=200
RAW_WRITER_FLUSH_INTERVAL_SECONDS=1.0

# Retention sweep (SRS §7)
RETENTION_EVENTS_HOURS=24
RETENTION_METRICS_DAYS=30
RETENTION_SWEEP_INTERVAL_SECONDS=3600
METRICS_ARCHIVE_ENABLED=true
METRICS_ARCHIVE_PATH=/tmp/its-data-intelligence/traffic_metrics

# Processor Prometheus endpoint
PROCESSOR_METRICS_PORT=9100

#This environment file defines configuration for Kafka, PostgreSQL, stream processing, API behavior, congestion calculation logic, and system monitoring parameters.
