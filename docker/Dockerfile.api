FROM python:3.11-slim

WORKDIR /app

# Install system deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev && \
    rm -rf /var/lib/apt/lists/*

# Install Python deps
COPY requirements/base.txt requirements/base.txt
COPY requirements/api.txt requirements/api.txt
RUN pip install --no-cache-dir -r requirements/api.txt \
    && pip install --no-cache-dir "kafka-python>=2.0,<3"

# ML deps for /api/predict/congestion (ST-GCN via traffic-predictor).
# CPU-only torch keeps the image ~250 MB lighter than the default CUDA wheel.
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu \
        "torch>=2.2,<3" \
    && pip install --no-cache-dir "torch-geometric>=2.5,<3"

# Copy source code
COPY src/shared/ /app/shared/
COPY src/api/ /app/api/
COPY traffic-predictor/ /app/traffic-predictor/

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
