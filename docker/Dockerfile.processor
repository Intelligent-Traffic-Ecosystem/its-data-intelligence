FROM python:3.11-slim

WORKDIR /app

# Install system deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev default-jre-headless wget && \
    rm -rf /var/lib/apt/lists/*

# Download Flink Kafka Connector JAR
RUN mkdir -p /opt/flink/lib && \
    wget -q https://repo.maven.apache.org/maven2/org/apache/flink/flink-sql-connector-kafka/3.3.0-1.20/flink-sql-connector-kafka-3.3.0-1.20.jar -O /opt/flink/lib/flink-sql-connector-kafka.jar

# Install Python deps
COPY requirements/base.txt requirements/base.txt
COPY requirements/processor.txt requirements/processor.txt
RUN pip install --no-cache-dir -r requirements/processor.txt

# Copy source code
COPY src/shared/ /app/shared/
COPY src/processor/ /app/processor/

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

CMD ["python", "-m", "processor.main"]
